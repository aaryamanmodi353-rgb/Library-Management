@{
    ViewData["Title"] = "About Us";
}

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

<style>
    /* Google Fonts */
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap');

    .about-us-page {
        font-family: 'Inter', sans-serif;
        color: #333;
        animation: fadeIn 0.8s ease-in-out;
    }

    /* Hero Section */
    .hero-section {
        position: relative;
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
        color: white;
        border-radius: 16px;
        padding: 80px 40px;
        text-align: center;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        overflow: hidden;
        margin-bottom: 60px;
    }
    
    .hero-section::before {
        content: '';
        position: absolute;
        top: -50%; left: -50%; width: 200%; height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 60%);
        animation: pulse 10s infinite linear;
    }

    .hero-title {
        font-weight: 800;
        font-size: 3.5rem;
        letter-spacing: -1px;
        margin-bottom: 20px;
        text-shadow: 0 4px 15px rgba(0,0,0,0.3);
        position: relative;
        z-index: 1;
    }

    .hero-subtitle {
        font-weight: 300;
        font-size: 1.25rem;
        max-width: 700px;
        margin: 0 auto;
        opacity: 0.9;
        position: relative;
        z-index: 1;
    }

    /* Mission Section */
    .mission-section {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(0,0,0,0.05);
        border-radius: 12px;
        padding: 50px;
        margin-bottom: 60px;
        display: flex;
        align-items: center;
        gap: 40px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.04);
    }
    
    .mission-image {
        flex: 1;
        border-radius: 12px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.1);
        width: 100%;
        height: 350px;
        object-fit: cover;
    }

    .mission-content {
        flex: 1.2;
    }

    .mission-title {
        font-weight: 800;
        font-size: 2.2rem;
        color: #212529;
        margin-bottom: 20px;
        background: linear-gradient(90deg, #1e3c72, #ff6b6b);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    /* Cards Section */
    .feature-card {
        background: #fff;
        border-radius: 12px;
        padding: 40px 30px;
        height: 100%;
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        border: 1px solid #f0f0f0;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .feature-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.08);
        border-color: transparent;
    }

    .feature-icon {
        font-size: 3rem;
        margin-bottom: 20px;
        color: #2a5298;
        transition: transform 0.3s ease;
    }

    .feature-card:hover .feature-icon {
        transform: scale(1.1);
        color: #ff6b6b;
    }

    .feature-card h5 {
        font-weight: 700;
        margin-bottom: 15px;
        color: #212529;
    }

    .feature-card p {
        color: #6c757d;
        font-size: 0.95rem;
        line-height: 1.6;
    }

    /* Animations */
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @@keyframes pulse {
        0% { transform: scale(1) rotate(0deg); }
        50% { transform: scale(1.1) rotate(180deg); }
        100% { transform: scale(1) rotate(360deg); }
    }

    @@media (max-width: 768px) {
        .mission-section {
            flex-direction: column;
        }
        .hero-title {
            font-size: 2.5rem;
        }
    }
</style>

<div class="about-us-page container mt-5 pb-5">
    
    <!-- Hero Section -->
    <div class="hero-section">
        <h1 class="hero-title">Discover the Future of Reading</h1>
        <p class="hero-subtitle">
            Welcome to LibraryManagement, your ultimate premium portal for seamless digital and physical resource tracking.
        </p>
    </div>

    <!-- Mission Section -->
    <div class="mission-section">
        <img src="https://images.unsplash.com/photo-1524995997946-a1c2e315a42f?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80" alt="Library Interior" class="mission-image">
        <div class="mission-content">
            <h2 class="mission-title">Our Mission</h2>
            <p class="lead text-secondary mb-4">
                We believe that managing knowledge should be as elegant as acquiring it. 
            </p>
            <p class="text-muted">
                Our platform simplifies school and university cataloging by providing a state-of-the-art, lightning-fast, and highly secure database solution. Whether you are a student exploring new realms of knowledge or an administrator organizing thousands of volumes, our system handles every request with just a few clicks—wrapped in a beautiful, intuitive interface.
            </p>
        </div>
    </div>

    <!-- Core Features Grid -->
    <div class="row g-4 mt-2">
        <div class="col-md-4">
            <div class="feature-card">
                <i class="bi bi-eye feature-icon"></i>
                <h5>Our Vision</h5>
                <p>To build connected, immersive environments where premium academic resources are accessible to everyone, instantly, without the clutter of traditional systems.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="feature-card">
                <i class="bi bi-cpu feature-icon"></i>
                <h5>Smart Tracking</h5>
                <p>Monitor real-time item checkouts, pending return dates, and stock limits automatically with precision-engineered algorithmic analytics.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="feature-card">
                <i class="bi bi-laptop feature-icon"></i>
                <h5>Easy Access</h5>
                <p>Experience a clean, glassmorphic interface optimized for desktop, tablet, and mobile screens alike—designed to wow from the very first glance.</p>
            </div>
        </div>
    </div>

</div>

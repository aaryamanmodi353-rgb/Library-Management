@model LibraryManagement.Models.BookListViewModel
@{
    ViewData["Title"] = "Books List";
}

<!-- Top Action Bar -->
<div class="d-flex justify-content-between align-items-center my-4 pb-2 border-bottom">
    <h2>Book Collection</h2>
    <div class="d-flex gap-3 align-items-center">
        <form asp-action="Index" method="get" class="form-inline d-flex gap-2">
            <input type="text" name="searchQuery" value="@Model.SearchQuery" class="form-control" placeholder="Search by title..." />
            <button type="submit" class="btn btn-outline-secondary">Search</button>
            @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
            {
                <a asp-action="Index" class="btn btn-link">Clear</a>
            }
        </form>
        <a asp-action="Create" class="btn btn-primary">Add New Book</a>
    </div>
</div>

<!-- Horizontal Sections with Images -->
<div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4 mb-5">
    @foreach (var book in Model.Books)
    {
        <div class="col">
            <div class="card h-100 shadow-sm border-0 hover-card">
                @if (!string.IsNullOrEmpty(book.ImageUrl))
                {
                    <img src="@book.ImageUrl" class="card-img-top p-3 rounded" alt="@book.Title" style="height: 250px; object-fit: cover;">
                }
                else
                {
                    <!-- Fallback placeholder -->
                    <div class="bg-secondary text-white d-flex align-items-center justify-content-center p-3 rounded-top" style="height: 250px;">
                        <span class="display-1">📖</span>
                    </div>
                }
                
                <div class="card-body d-flex flex-column text-center">
                    <h5 class="card-title fw-bold text-truncate" title="@book.Title">@book.Title</h5>
                    <p class="card-text text-muted mb-2">@book.Author</p>
                    <p class="card-text mb-3"><small class="text-secondary">@book.PublishedDate.ToString("MMM dd, yyyy")</small></p>
                    
                    <div class="mt-auto">
                        <div class="mb-3">
                            <span class="badge @(book.IsAvailable ? "bg-success" : "bg-danger") px-3 py-2 w-100">
                                @(book.IsAvailable ? "Available" : "Checked Out")
                            </span>
                        </div>
                        <div class="d-flex flex-wrap gap-2 justify-content-center">
                            <a asp-action="Details" asp-route-id="@book.BookId" class="btn btn-outline-info btn-sm">Details</a>
                            <a asp-action="Edit" asp-route-id="@book.BookId" class="btn btn-outline-warning btn-sm">Edit</a>
                            <a asp-action="Delete" asp-route-id="@book.BookId" class="btn btn-outline-danger btn-sm">Delete</a>
                        </div>
                        <div class="mt-2">
                            @if (book.IsAvailable)
                            {
                                <a asp-controller="Borrow" asp-action="Create" asp-route-bookId="@book.BookId" class="btn btn-primary btn-sm w-100">Borrow</a>
                            }
                            else
                            {
                                var activeBorrowRecord = book.BorrowRecords?.FirstOrDefault(br => br.ReturnDate == null);
                                if (activeBorrowRecord != null)
                                {
                                    <a asp-controller="Borrow" asp-action="Return" asp-route-borrowRecordId="@activeBorrowRecord.BorrowRecordId" class="btn btn-success btn-sm w-100">Return</a>
                                }
                                else
                                {
                                    <span class="text-muted w-100 d-block small">No active borrow record</span>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Books.Any())
{
    <div class="text-center py-5 text-muted">
        <h4>No books found matching your criteria.</h4>
    </div>
}

<!-- Pagination Controls -->
@if (Model.TotalPages > 1)
{
    <nav aria-label="Page navigation" class="mt-4">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                    <a class="page-item page-link" asp-action="Index" 
                       asp-route-page="@i" 
                       asp-route-searchQuery="@Model.SearchQuery">@i</a>
                </li>
            }
        </ul>
    </nav>
}

<style>
    .hover-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }
    .hover-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
    }
</style>
